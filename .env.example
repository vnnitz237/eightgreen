DATABASE_URL="postgresql://eightgreen:eightgreen_dev@127.0.0.1:55432/eightgreen?schema=public"
DIRECT_URL="postgresql://eightgreen:eightgreen_dev@127.0.0.1:55432/eightgreen?schema=public"

# Gere um valor aleatório com pelo menos 32 caracteres. Nunca reutilize entre ambientes.
AUTH_SECRET="substitua-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"

# Criação única do primeiro proprietário: npm run owner:create
OWNER_NAME="Nome do proprietário"
OWNER_EMAIL="proprietario@exemplo.com"

# Seed local: nunca reutilize estas credenciais fora de um ambiente isolado.
SEED_ADMIN_NAME="Administrador de desenvolvimento"
SEED_ADMIN_EMAIL="admin.dev@eightgreen.local"
SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte-local"
SEED_FUNCIONARIO_NAME="Funcionário de desenvolvimento"
SEED_FUNCIONARIO_EMAIL="funcionario.dev@eightgreen.local"
SEED_FUNCIONARIO_PASSWORD="troque-por-outra-senha-forte-local"

# E-mail: "api" ou "arquivo". O modo arquivo é aceito somente fora de produção.
EMAIL_PROVIDER="arquivo"
EMAIL_FROM="Eight Green <acesso@exemplo.com>"
EMAIL_API_URL="https://api.provedor.example/send"
EMAIL_API_KEY="chave-do-provedor"
