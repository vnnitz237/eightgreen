generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum StatusAcao {
  aberta
  encerrada
  cancelada
}

enum TipoMovimentacaoEstoque {
  entrada
  saida
  ajuste
}

enum TipoContaFinanceira {
  pagar
  receber
  despesa
}

enum PapelUsuario {
  ADMINISTRADOR
  FUNCIONARIO
}

enum EstadoConvite {
  PENDENTE
  ACEITO
  ENVIO_FALHOU
}

enum TipoDocumentoEstoque {
  ENTRADA
  SAIDA
  INVENTARIO
}

enum StatusDocumentoEstoque {
  ABERTO
  ENCERRADO
  CANCELADO
}

enum StatusContaPagar {
  ABERTA
  PAGA
  CANCELADA
}

enum TipoCompromisso {
  REUNIAO
  VISITA
  ENTREGA
  DEGUSTACAO
  OUTRO
}

enum StatusContaReceber {
  ABERTA
  RECEBIDA
  CANCELADA
}

enum StatusDespesaEmpresarial {
  ABERTA
  ENCERRADA
  CANCELADA
}

enum TipoLancamentoCC {
  DEBITO
  CREDITO
}

enum StatusRota {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

// ─── Cadastros base ──────────────────────────────────────────────────────────

model Distribuidora {
  id       String   @id @default(cuid())
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  canal   Canal?  @relation(fields: [canalId], references: [id], onDelete: SetNull)
  canalId String? @map("canal_id")

  acoes            Acao[]
  estabelecimentos Estabelecimento[]
  registrosMerchan RegistroMerchan[]

  @@map("distribuidoras")
}

model Estabelecimento {
  id           String   @id @default(cuid())
  razaoSocial  String   @map("nome")
  nomeFantasia String?  @map("nome_fantasia")
  cnpjCpf      String?  @map("cnpj_cpf")
  ieRg         String?  @map("ie_rg")
  endereco     String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  uf           String?
  cep          String?
  telefone     String?
  email        String?
  contato      String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  distribuidora   Distribuidora? @relation(fields: [distribuidoraId], references: [id], onDelete: SetNull)
  distribuidoraId String?        @map("distribuidora_id")
  canal           Canal?         @relation(fields: [canalId], references: [id], onDelete: SetNull)
  canalId         String?        @map("canal_id")

  acoes            Acao[]
  registrosMerchan RegistroMerchan[]
  contasReceber    ContaReceber[]
  contasCorrentes  ContaCorrenteCliente[]
  rotas            RotaEstabelecimento[]
  compromissos     Compromisso[]
  merchan          Merchan[]
  rotaParadas      RotaParada[]

  @@map("estabelecimentos")
}

model Degustadora {
  id       String   @id @default(cuid())
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  telefone String?
  email    String?
  cpf      String?
  rg       String?
  cidade   String?
  uf       String?
  agencia  String?
  conta    String?

  fornecedor       Fornecedor?        @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  fornecedorId     String?            @map("fornecedor_id")
  bancoDados       Banco?             @relation(fields: [bancoDadosId], references: [id], onDelete: SetNull)
  bancoDadosId     String?            @map("banco_dados_id")
  participacoes    AcaoProfissional[]
  acaoDegustadoras AcaoDegustadora[]
  contasPagar      ContaPagar[]
  usuario          Usuario?

  @@map("degustadoras")
}

// Usuário de autenticação é distinto dos cadastros de negócio.
model Usuario {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  passwordHash       String?       @map("password_hash")
  mustChangePassword Boolean       @default(true) @map("must_change_password")
  estadoConvite      EstadoConvite @default(PENDENTE) @map("estado_convite")
  credencialExpiraEm DateTime?     @map("credencial_expira_em")
  conviteEnviadoEm   DateTime?     @map("convite_enviado_em")
  conviteAceitoEm    DateTime?     @map("convite_aceito_em")
  papel              PapelUsuario  @default(FUNCIONARIO)
  ativo              Boolean       @default(true)
  ultimoAcesso       DateTime?     @map("ultimo_acesso")
  criadoEm           DateTime      @default(now()) @map("criado_em")
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em")

  degustadora             Degustadora?         @relation(fields: [degustadoraId], references: [id], onDelete: SetNull)
  degustadoraId           String?              @unique @map("degustadora_id")
  sessoes                 Sessao[]
  auditorias              Auditoria[]
  compromissosResponsavel Compromisso[]        @relation("CompromissoResponsavel")
  documentosEstoque       DocumentoEstoque[]   @relation("DocEstoqueResponsavel")
  registrosMerchan        RegistroMerchan[]
  rotas                   Rota[]
  despesas                DespesaEmpresarial[]
  despesasViagem          DespesaViagem[]
  merchanPromotor         Merchan[]            @relation("MerchanPromotor")
  rotasPromotor           Rota[]               @relation("RotaPromotor")

  @@map("usuarios")
}

model Sessao {
  sessionToken String   @unique @map("token_sessao")
  userId       String   @map("usuario_id")
  expires      DateTime @map("expira_em")
  criadoEm     DateTime @default(now()) @map("criado_em")
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessoes")
}

model Auditoria {
  id              String   @id @default(cuid())
  operacao        String
  entidade        String
  registroId      String   @map("registro_id")
  estadoAnterior  Json?    @map("estado_anterior")
  estadoPosterior Json?    @map("estado_posterior")
  criadoEm        DateTime @default(now()) @map("criado_em")

  autor   Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)
  autorId String  @map("autor_id")

  @@index([entidade, registroId])
  @@index([autorId, criadoEm])
  @@map("auditorias")
}

model Fornecedor {
  id           String   @id @default(cuid())
  razaoSocial  String   @map("nome")
  nomeFantasia String?  @map("nome_fantasia")
  cnpj         String?
  ie           String?
  endereco     String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  uf           String?
  cep          String?
  telefone     String?
  email        String?
  contato      String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  documentosEstoque DocumentoEstoque[]
  contasPagar       ContaPagar[]
  degustadoras      Degustadora[]

  @@map("fornecedores")
}

model GrupoProduto {
  id       String   @id @default(cuid())
  nome     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  produtos Produto[]

  @@map("grupos_produto")
}

model Canal {
  id       String   @id @default(cuid())
  nome     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  distribuidoras   Distribuidora[]
  estabelecimentos Estabelecimento[]

  @@map("canais")
}

model Banco {
  id       String   @id @default(cuid())
  nome     String   @unique
  codigo   String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]
  degustadoras  Degustadora[]
  lancamentos   LancamentoBanco[]

  @@map("bancos")
}

model Produto {
  id            String   @id @default(cuid())
  codigo        String?  @unique
  nome          String
  unidade       String   @default("UN")
  estoqueMinimo Decimal  @default(0) @map("estoque_minimo") @db.Decimal(14, 3)
  custo         Decimal? @db.Decimal(12, 2)
  valorVenda    Decimal? @map("valor_venda") @db.Decimal(12, 2)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  grupo   GrupoProduto? @relation(fields: [grupoId], references: [id])
  grupoId String?       @map("grupo_id")

  acoesProduto     AcaoProduto[]
  movimentacoes    MovimentacaoEstoque[]
  documentosItem   DocumentoEstoqueItem[]
  registrosMerchan RegistroMerchanProduto[]
  saldoEstoque     SaldoEstoque?

  @@map("produtos")
}

// ─── Ação promocional ────────────────────────────────────────────────────────

model Acao {
  id          String     @id @default(cuid())
  numero      String     @unique @default(cuid()) @map("numero")
  titulo      String
  data        DateTime   @db.Date
  dataFim     DateTime?  @db.Date @map("data_fim")
  horario     String
  status      StatusAcao @default(aberta)
  observacoes String?

  distribuidora   Distribuidora? @relation(fields: [distribuidoraId], references: [id])
  distribuidoraId String?        @map("distribuidora_id")

  estabelecimento       Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
  estabelecimentoId     String?          @map("estabelecimento_id")
  estabelecimentoAvulso String?          @map("estabelecimento_avulso")

  profissionais    AcaoProfissional[]
  produtos         AcaoProduto[]
  acaoDegustadoras AcaoDegustadora[]
  compromissos     Compromisso[]

  criadoEm          DateTime           @default(now()) @map("criado_em")
  atualizadoEm      DateTime           @updatedAt @map("atualizado_em")
  documentosEstoque DocumentoEstoque[]
  contasReceber     ContaReceber[]     @relation("AcaoContasReceber")
  contasPagar       ContaPagar[]       @relation("AcaoContasPagar")

  @@map("acoes")
}

model AcaoProfissional {
  id String @id @default(cuid())

  acao   Acao   @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  acaoId String @map("acao_id")

  degustadora   Degustadora? @relation(fields: [degustadoraId], references: [id])
  degustadoraId String?      @map("degustadora_id")

  nomeAvulso      String? @map("nome_avulso")
  valorIndividual Decimal @default(0) @map("valor_individual") @db.Decimal(12, 2)

  contasPagar ContaPagar[]

  @@map("acao_profissionais")
}

model AcaoProduto {
  id String @id @default(cuid())

  acao   Acao   @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  acaoId String @map("acao_id")

  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId String  @map("produto_id")

  quantidadePlanejada Int     @map("quantidade_planejada")
  preco               Decimal @default(0) @db.Decimal(10, 2)

  @@map("acao_produtos")
}

model AcaoDegustadora {
  id String @id @default(cuid())

  acao   Acao   @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  acaoId String @map("acao_id")

  degustadora   Degustadora @relation(fields: [degustadoraId], references: [id])
  degustadoraId String      @map("degustadora_id")

  dataTrabalho DateTime @db.Date @map("data_trabalho")
  horaInicio   String   @map("hora_inicio")
  horaFim      String   @map("hora_fim")
  observacoes  String?

  @@map("acao_degustadoras")
}

// ─── Estoque ─────────────────────────────────────────────────────────────────

model MovimentacaoEstoque {
  id         String                  @id @default(cuid())
  tipo       TipoMovimentacaoEstoque
  quantidade Decimal                 @db.Decimal(14, 3)
  observacao String?
  criadoEm   DateTime                @default(now()) @map("criado_em")

  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId String  @map("produto_id")

  documentoItem   DocumentoEstoqueItem? @relation(fields: [documentoItemId], references: [id], onDelete: SetNull)
  documentoItemId String?               @map("documento_item_id")

  @@map("movimentacoes_estoque")
}

model DocumentoEstoque {
  id           String                 @id @default(cuid())
  numero       String?                @unique
  tipo         TipoDocumentoEstoque
  status       StatusDocumentoEstoque @default(ABERTO)
  data         DateTime               @db.Date
  numeroNota   String?                @map("numero_nota")
  serieNota    String?                @map("serie_nota")
  observacao   String?
  criadoEm     DateTime               @default(now()) @map("criado_em")
  atualizadoEm DateTime               @updatedAt @map("atualizado_em")

  fornecedor    Fornecedor?            @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  fornecedorId  String?                @map("fornecedor_id")
  acao          Acao?                  @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  acaoId        String?                @map("acao_id")
  responsavel   Usuario?               @relation("DocEstoqueResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId String?                @map("responsavel_id")
  itens         DocumentoEstoqueItem[]

  @@map("documentos_estoque")
}

model DocumentoEstoqueItem {
  id             String   @id @default(cuid())
  quantidade     Decimal  @db.Decimal(14, 3)
  valorUnitario  Decimal? @map("valor_unitario") @db.Decimal(12, 2)
  saldoSistema   Decimal? @map("saldo_sistema") @db.Decimal(14, 3)
  contagemFisica Decimal? @map("contagem_fisica") @db.Decimal(14, 3)

  documento     DocumentoEstoque      @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  documentoId   String                @map("documento_id")
  produto       Produto               @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  produtoId     String                @map("produto_id")
  movimentacoes MovimentacaoEstoque[]

  @@unique([documentoId, produtoId])
  @@map("documentos_estoque_itens")
}

model SaldoEstoque {
  id           String   @id @default(cuid())
  produtoId    String   @unique @map("produto_id")
  produto      Produto  @relation(fields: [produtoId], references: [id])
  quantidade   Int      @default(0)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("saldos_estoque")
}

// ─── Financeiro ──────────────────────────────────────────────────────────────

model ContaFinanceira {
  id         String              @id @default(cuid())
  descricao  String
  valor      Decimal             @db.Decimal(12, 2)
  tipo       TipoContaFinanceira
  vencimento DateTime            @db.Date
  pago       Boolean             @default(false)
  criadoEm   DateTime            @default(now()) @map("criado_em")

  @@map("contas_financeiras")
}

model DespesaOperacional {
  id        String   @id @default(cuid())
  descricao String
  valor     Decimal  @db.Decimal(12, 2)
  data      DateTime @db.Date
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("despesas_operacionais")
}

model ContaPagar {
  id            String           @id @default(cuid())
  numero        String?          @unique
  descricao     String
  categoria     String?
  valor         Decimal          @db.Decimal(12, 2)
  emissao       DateTime         @db.Date
  vencimento    DateTime         @db.Date
  status        StatusContaPagar @default(ABERTA)
  dataPagamento DateTime?        @map("data_pagamento") @db.Date
  formaPagamento String?         @map("forma_pagamento")
  favorecido    String?
  criadoEm      DateTime         @default(now()) @map("criado_em")
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em")

  banco                Banco?              @relation(fields: [bancoId], references: [id], onDelete: SetNull)
  bancoId              String?             @map("banco_id")
  fornecedor           Fornecedor?         @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  fornecedorId         String?             @map("fornecedor_id")
  degustadora          Degustadora?        @relation(fields: [degustadoraId], references: [id], onDelete: SetNull)
  degustadoraId        String?             @map("degustadora_id")
  acaoProfissional     AcaoProfissional?   @relation(fields: [acaoProfissionalId], references: [id], onDelete: SetNull)
  acaoProfissionalId   String?             @map("acao_degustadora_id")
  despesaEmpresarial   DespesaEmpresarial? @relation(fields: [despesaEmpresarialId], references: [id], onDelete: SetNull)
  despesaEmpresarialId String?             @map("despesa_empresarial_id")
  acao                 Acao?               @relation("AcaoContasPagar", fields: [acaoId], references: [id], onDelete: SetNull)
  acaoId               String?             @map("acao_id")
  lancamentos          LancamentoBanco[]

  @@map("contas_pagar")
}

model ContaReceber {
  id              String             @id @default(cuid())
  numero          String?            @unique
  descricao       String
  categoria       String?
  valor           Decimal            @db.Decimal(12, 2)
  emissao         DateTime           @db.Date
  vencimento      DateTime           @db.Date
  status          StatusContaReceber @default(ABERTA)
  dataRecebimento DateTime?          @map("data_recebimento") @db.Date
  formaPagamento  String?            @map("forma_pagamento")
  criadoEm        DateTime           @default(now()) @map("criado_em")
  atualizadoEm    DateTime           @updatedAt @map("atualizado_em")

  banco             Banco?           @relation(fields: [bancoId], references: [id], onDelete: SetNull)
  bancoId           String?          @map("banco_id")
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: SetNull)
  estabelecimentoId String?          @map("estabelecimento_id")
  acao              Acao?            @relation("AcaoContasReceber", fields: [acaoId], references: [id], onDelete: SetNull)
  acaoId            String?          @map("acao_id")
  lancamentosCC     LancamentoCC[]
  lancamentosBanco  LancamentoBanco[]

  @@map("contas_receber")
}

model DespesaEmpresarial {
  id           String                   @id @default(cuid())
  descricao    String
  dataInicio   DateTime                 @map("data_inicio") @db.Date
  dataFim      DateTime                 @map("data_fim") @db.Date
  destino      String?
  status       StatusDespesaEmpresarial @default(ABERTA)
  criadoEm     DateTime                 @default(now()) @map("criado_em")
  atualizadoEm DateTime                 @updatedAt @map("atualizado_em")

  responsavel   Usuario?      @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId String?       @map("responsavel_id")
  itens         DespesaItem[]
  contasPagar   ContaPagar[]

  @@map("despesas_empresariais")
}

model DespesaItem {
  id          String   @id @default(cuid())
  data        DateTime @db.Date
  tipo        String
  descricao   String?
  valor       Decimal  @db.Decimal(12, 2)
  comprovante String?

  despesa   DespesaEmpresarial @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  despesaId String             @map("despesa_id")

  @@map("despesas_itens")
}

model LancamentoBanco {
  id        String           @id @default(cuid())
  data      DateTime         @db.Date
  historico String
  tipo      TipoLancamentoCC
  valor     Decimal          @db.Decimal(12, 2)
  criadoEm  DateTime         @default(now()) @map("criado_em")

  banco          Banco        @relation(fields: [bancoId], references: [id], onDelete: Cascade)
  bancoId        String       @map("banco_id")
  contaPagar     ContaPagar?  @relation(fields: [contaPagarId], references: [id], onDelete: SetNull)
  contaPagarId   String?      @map("conta_pagar_id")
  contaReceber   ContaReceber? @relation(fields: [contaReceberId], references: [id], onDelete: SetNull)
  contaReceberId String?       @map("conta_receber_id")

  @@map("lancamentos_banco")
}

model DespesaViagem {
  id          String   @id @default(cuid())
  descricao   String
  data        DateTime @db.Date
  destino     String?
  tipoDespesa String?  @map("tipo_despesa")
  valor       Decimal  @db.Decimal(12, 2)
  comprovante String?
  criadoEm    DateTime @default(now()) @map("criado_em")

  colaborador   Usuario? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  colaboradorId String?  @map("colaborador_id")

  @@map("despesas_viagem")
}

model ContaCorrenteCliente {
  id       String   @id @default(cuid())
  criadoEm DateTime @default(now()) @map("criado_em")

  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Restrict)
  estabelecimentoId String          @unique @map("estabelecimento_id")
  lancamentos       LancamentoCC[]

  @@map("contas_correntes_clientes")
}

model LancamentoCC {
  id        String           @id @default(cuid())
  data      DateTime         @db.Date
  historico String
  tipo      TipoLancamentoCC
  valor     Decimal          @db.Decimal(12, 2)
  origem    String           @default("MANUAL")
  criadoEm  DateTime         @default(now()) @map("criado_em")

  contaCorrente   ContaCorrenteCliente @relation(fields: [contaCorrenteId], references: [id], onDelete: Cascade)
  contaCorrenteId String               @map("conta_corrente_id")
  contaReceber    ContaReceber?        @relation(fields: [contaReceberId], references: [id], onDelete: SetNull)
  contaReceberId  String?              @map("conta_receber_id")

  @@map("lancamentos_cc")
}

// ─── Merchan ─────────────────────────────────────────────────────────────────

model RegistroMerchan {
  id            String   @id @default(cuid())
  data          DateTime @db.Date
  observacao    String?
  tipoAtividade String?  @map("tipo_atividade")
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  foto          String?
  criadoEm      DateTime @default(now()) @map("criado_em")

  distribuidora   Distribuidora? @relation(fields: [distribuidoraId], references: [id])
  distribuidoraId String?        @map("distribuidora_id")

  estabelecimento       Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
  estabelecimentoId     String?          @map("estabelecimento_id")
  estabelecimentoAvulso String?          @map("estabelecimento_avulso")

  responsavel   Usuario?                 @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId String?                  @map("responsavel_id")
  produtos      RegistroMerchanProduto[]

  @@map("merchan")
}

model RegistroMerchanProduto {
  registro   RegistroMerchan @relation(fields: [registroId], references: [id], onDelete: Cascade)
  registroId String          @map("registro_id")
  produto    Produto         @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  produtoId  String          @map("produto_id")

  @@id([registroId, produtoId])
  @@map("registros_merchan_produtos")
}

model Merchan {
  id           String   @id @default(cuid())
  data         DateTime @db.Date
  horaEntrada  String?  @map("hora_entrada")
  horaSaida    String?  @map("hora_saida")
  latEntrada   Float?   @map("lat_entrada")
  lngEntrada   Float?   @map("lng_entrada")
  latSaida     Float?   @map("lat_saida")
  lngSaida     Float?   @map("lng_saida")
  fotos        String[]
  checklistOk  Boolean  @default(false) @map("checklist_ok")
  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: SetNull)
  estabelecimentoId String?          @map("estabelecimento_id")
  promotor          Usuario?         @relation("MerchanPromotor", fields: [promotorId], references: [id], onDelete: SetNull)
  promotorId        String?          @map("promotor_id")
  rotaParada        RotaParada?

  @@map("merchan_visitas")
}

model RotaParada {
  id       String  @id @default(cuid())
  ordem    Int     @default(0)
  visitado Boolean @default(false)

  rota              Rota            @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  rotaId            String          @map("rota_id")
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Restrict)
  estabelecimentoId String          @map("estabelecimento_id")
  merchan           Merchan?        @relation(fields: [merchanId], references: [id], onDelete: SetNull)
  merchanId         String?         @unique @map("merchan_id")

  @@map("rota_paradas")
}

// ─── Pessoal ─────────────────────────────────────────────────────────────────

model Compromisso {
  id           String          @id @default(cuid())
  titulo       String
  tipo         TipoCompromisso @default(OUTRO)
  inicio       DateTime
  fim          DateTime
  diaInteiro   Boolean         @default(false) @map("dia_inteiro")
  observacoes  String?
  criadoEm     DateTime        @default(now()) @map("criado_em")
  atualizadoEm DateTime        @updatedAt @map("atualizado_em")

  responsavel       Usuario?         @relation("CompromissoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId     String?          @map("responsavel_id")
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: SetNull)
  estabelecimentoId String?          @map("estabelecimento_id")
  acao              Acao?            @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  acaoId            String?          @map("acao_id")

  @@map("compromissos")
}

model Rota {
  id        String   @id @default(cuid())
  descricao String
  nome      String   @default("")
  data      DateTime @db.Date
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  ativo            Boolean    @default(true)
  status           StatusRota @default(PENDENTE)
  observacoes      String?
  responsavel      Usuario?   @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  responsavelId    String?    @map("responsavel_id")
  promotor         Usuario?   @relation("RotaPromotor", fields: [promotorId], references: [id], onDelete: SetNull)
  promotorId       String?    @map("promotor_id")
  estabelecimentos RotaEstabelecimento[]
  paradas          RotaParada[]

  @@map("rotas")
}

model RotaEstabelecimento {
  rota              Rota            @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  rotaId            String          @map("rota_id")
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Restrict)
  estabelecimentoId String          @map("estabelecimento_id")
  ordem             Int?

  @@id([rotaId, estabelecimentoId])
  @@map("rotas_estabelecimentos")
}
